__pycache__/
*.py[cod]

output/*
!output/.gitkeep

# Exports reais do Watson Assistant são dados locais e não devem ser versionados.
input/*.json
dist/production_mutants/
dist/novos_testes/
dist/synthesized_tests/
dist/synthesized_gaps/
dist/*.json

# Local/editor/runtime artifacts
*.log
*.tmp
.DS_Store
Thumbs.db

# Mutation/checkpoint outputs are runtime evidence, not source.
*.jsonl
# Relay/audit/planning artifacts are operational evidence, not source.
.relay/

# Local credentials and private working material (never publication inputs)
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.local.env
/.aws/
/.ssh/
/.secrets/
/.credentials/
/.private/
/.internal/
/.reconciliation/
credentials.local.*
id_rsa
id_ed25519
*.p12
*.pfx
.claude/settings.local.json
.aider*

# SQLite runtime sidecars can contain the same private data as the database
*.db-wal
*.db-shm
*.db-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal

# Regenerable local tool state
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
